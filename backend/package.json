{
  "name": "naas-backend",
  "version": "1.0.0",
  "description": "NjangiBridge (NAAS) — Express API backend",
  "main": "src/app.js",
  "scripts": {
    "start": "node src/app.js",
    "dev": "nodemon src/app.js",
    "lint": "eslint src/ --ext .js",
    "test": "jest --runInBand",
    "test:unit": "jest tests/unit",
    "test:integration": "jest tests/integration",
    "test:smoke": "jest tests/integration/smoke.test.js",
    "test:security": "jest tests/security",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage"
  },
  "jest": {
    "testEnvironment": "node",
    "setupFiles": [
      "./tests/setup.js"
    ],
    "testMatch": [
      "**/tests/**/*.test.js"
    ],
    "collectCoverageFrom": [
      "src/**/*.js",
      "!src/app.js",
      "!src/modules/**/*.controller.js",
      "!src/modules/**/*.routes.js",
      "!src/modules/**/*.validation.js",
      "!src/jobs/**/*.js",
      "!src/middleware/error.middleware.js",
      "!src/services/payment/MTNMoMoService.js",
      "!src/services/payment/OrangeMoneyService.js",
      "!src/services/notification/SMSNotificationService.js",
      "!src/services/notification/WhatsAppNotificationService.js"
    ],
    "coverageThreshold": {
      "global": {
        "lines": 70
      }
    }
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.39.0",
    "bcrypt": "^5.1.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.1",
    "express": "^4.18.2",
    "joi": "^17.11.0",
    "jsonwebtoken": "^9.0.2",
    "node-cron": "^3.0.3",
    "otplib": "^13.4.1",
    "pdfkit": "^0.14.0",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.0",
    "twilio": "^4.21.0",
    "uuid": "^9.0.0",
    "whatsapp-web.js": "^1.34.7"
  },
  "devDependencies": {
    "@jest/globals": "^29.7.0",
    "eslint": "^8.56.0",
    "jest": "^29.7.0",
    "nodemon": "^3.0.3",
    "supertest": "^6.3.4"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
