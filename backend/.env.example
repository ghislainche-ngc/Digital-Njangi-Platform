# ============================================================
# NAAS Backend — Environment Variables
# Copy this file to .env and fill in the values.
# NEVER commit .env — it contains secrets.
# ============================================================

# Supabase (get from your Supabase project -> Settings -> API)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_KEY=your-service-role-key

# JWT
JWT_SECRET=your-secret-key-at-least-32-characters-long

# Server
PORT=3000
NODE_ENV=development

# MTN MoMo Sandbox (register at developer.mtn.com)
MTN_MOMO_API_USER=
MTN_MOMO_API_KEY=
MTN_MOMO_SUBSCRIPTION_KEY=
MTN_MOMO_TARGET_ENV=sandbox
MTN_MOMO_CALLBACK_URL=

# Orange Money
ORANGE_MONEY_API_KEY=
ORANGE_MONEY_BASE_URL=

# Telegram Bot (create via @BotFather on Telegram)
TELEGRAM_BOT_TOKEN=

# Africa's Talking SMS
AT_API_KEY=
AT_USERNAME=
AT_SENDER_ID=

# ─── Campay payment gateway (https://campay.net) ──────────────────────────
# Credentials come from the Campay dashboard after creating an app.
# APP_USERNAME + APP_PASSWORD are used to obtain a 1-hour JWT from POST /api/token/.
# APP_WEBHOOK_KEY is the separate signing key used to verify webhook authenticity.
# PERMANENT_ACCESS_TOKEN can be used for direct API calls where supported.
# Never commit real values — they live in backend/.env (gitignored).
APP_ID=
APP_USERNAME=
APP_PASSWORD=
PERMANENT_ACCESS_TOKEN=
APP_WEBHOOK_KEY=

# Base URL. Sandbox default; override only for production.
CAMPAY_BASE_URL=https://demo.campay.net/api

# Public URL Campay will GET (or POST) payment notifications to. Configure
# the same value + method in the Campay dashboard. Must be reachable from
# Campay's servers — use the Contabo VPS hostname for demo, or ngrok locally.
CAMPAY_NOTIFY_URL=https://your-naas-host.example.com/webhooks/campay
