# ============================================================
# NAAS Backend — Environment Variables
# Copy this file to .env and fill in the values.
# NEVER commit .env — it contains secrets.
# ============================================================

# Supabase (get from your Supabase project -> Settings -> API)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_KEY=your-service-role-key

# JWT
JWT_SECRET=your-secret-key-at-least-32-characters-long

# Server
PORT=3000
NODE_ENV=development

# MTN MoMo Sandbox (register at developer.mtn.com)
MTN_MOMO_API_USER=
MTN_MOMO_API_KEY=
MTN_MOMO_SUBSCRIPTION_KEY=
MTN_MOMO_TARGET_ENV=sandbox
MTN_MOMO_CALLBACK_URL=

# Orange Money
ORANGE_MONEY_API_KEY=
ORANGE_MONEY_BASE_URL=

# Telegram Bot (create via @BotFather on Telegram)
TELEGRAM_BOT_TOKEN=

# Africa's Talking SMS
AT_API_KEY=
AT_USERNAME=
AT_SENDER_ID=
